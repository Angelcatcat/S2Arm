<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="s2arm-ryujinx" value="../../compat/packages" />
  </packageSources>
  <!-- 根目录 nuget.config 的来源映射只认它自己的源，会把上面这个本地源排除，这里清掉 -->
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
