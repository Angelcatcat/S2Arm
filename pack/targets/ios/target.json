{
  "schema": "s2a.target.v1",
  "id": "ios",
  "execution": "host",
  "entry": "pack/jobs/target_main.py",
  "host": {
    "requires": {
      "os": [
        "macos"
      ],
      "arch": [
        "arm64"
      ],
      "tools": [
        "xcode",
        "metal",
        "dotnet-sdk-10",
        "python3"
      ]
    },
    "variants": [
      {
        "id": "windows",
        "os": "windows",
        "available": false,
        "trackingIssue": 179,
        "description": "Windows 出 iOS 包：J05 可行性与原型尚未完成"
      },
      {
        "id": "linux",
        "os": "linux",
        "available": false,
        "trackingIssue": 179,
        "description": "Linux 出 iOS 包：J05 可行性与原型尚未完成"
      }
    ]
  },
  "device": {
    "os": [
      "ios",
      "ipados"
    ],
    "minVersion": 26,
    "targetFields": [
      "gpuArch",
      "os"
    ]
  },
  "recipes": [
    {
      "id": "ipa",
      "operation": "ipa",
      "stages": [
        "input.validate",
        "input.unpack",
        "rewrite",
        "sysdata",
        "uilayout",
        "aoc",
        "romfsidx",
        "direct",
        "direct.library",
        "direct.shader.package",
        "bundle.ipa",
        "widen.auto"
      ],
      "description": "refresh.sh 的阶段同名同序声明；前四段并行，随后 RomFS 索引与直连库（只有直连，11-07 拆通用模式）。清单不是固定执行器。",
      "policy": "只出直连包：直连配置推导、抽取或出库做不成报红，不退成通用包。实际是否出库以旧管线为准。"
    }
  ],
  "stages": [
    {
      "id": "input.validate",
      "description": "检查游戏输入",
      "implementation": "pack/jobs/ipa.py:build",
      "execution": "build",
      "startsGame": false,
      "observation": "milestone"
    },
    {
      "id": "input.unpack",
      "description": "选择并解包游戏",
      "implementation": "pack/oneclick/oneclick.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "milestone"
    },
    {
      "id": "rewrite",
      "description": "改写游戏代码",
      "implementation": "pack/stage_rewrite.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "milestone",
      "parallelGroup": "refresh.independent"
    },
    {
      "id": "sysdata",
      "description": "准备系统数据",
      "implementation": "pack/stage_sysdata.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "declared",
      "parallelGroup": "refresh.independent"
    },
    {
      "id": "uilayout",
      "description": "准备界面布局",
      "implementation": "pack/stage_uilayout.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "declared",
      "parallelGroup": "refresh.independent"
    },
    {
      "id": "aoc",
      "description": "准备追加内容清单与数据",
      "implementation": "pack/stage_aoc.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "declared",
      "parallelGroup": "refresh.independent"
    },
    {
      "id": "romfsidx",
      "description": "建立资源索引",
      "implementation": "pack/stage_romfsidx.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "declared",
      "parallelGroup": "refresh.alongside-direct"
    },
    {
      "id": "direct",
      "description": "按直连配置出直连着色器库",
      "implementation": "pack/stage_direct.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "declared",
      "condition": "每款都出（10-30 维护者 直连单轨：不看有没有手写配置档，先零配置推导）；推导、抽取或出库做不成报红「直连单轨停在 <哪一步>」、refresh.sh 退出 1，不退成通用包。"
    },
    {
      "id": "direct.library",
      "description": "按原有构建配置将直连库链接进 App",
      "implementation": "graphics/build.mk",
      "execution": "build",
      "startsGame": false,
      "observation": "declared"
    },
    {
      "id": "direct.shader.package",
      "description": "将实际已有的直连着色器库随 shaders 资源目录进包",
      "implementation": "pack/ipa.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "declared",
      "availability": "existing_inputs_only",
      "condition": "实际存在直连库；空产物不当作已交付。"
    },
    {
      "id": "bundle.ipa",
      "description": "构建、签名并打包 App 和资源包",
      "implementation": "pack/ipa.sh",
      "execution": "build",
      "startsGame": false,
      "observation": "milestone"
    },
    {
      "id": "widen.auto",
      "description": "自动生成宽屏表（沿用原有异步触发）",
      "implementation": "graphics/widen/scan/auto_kick.sh",
      "execution": "build",
      "startsGame": true,
      "observation": "declared"
    }
  ]
}
