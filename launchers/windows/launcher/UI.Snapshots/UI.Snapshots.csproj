<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Protocol/Protocol.csproj" />
    <ProjectReference Include="../App/S2Arm.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../shared/experience.v1.json" LogicalName="S2Arm.experience.v1.json" />
    <EmbeddedResource Include="../App/Assets/Fonts/Manrope-Regular.ttf" LogicalName="S2Arm.Assets.Fonts.Manrope-Regular.ttf" />
    <EmbeddedResource Include="../App/Assets/Fonts/Manrope-SemiBold.ttf" LogicalName="S2Arm.Assets.Fonts.Manrope-SemiBold.ttf" />
  </ItemGroup>
</Project>
